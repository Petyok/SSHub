#!/usr/bin/env bash
# Demo stand-in for `ping`, on PATH next to demo/bin/ssh for demo/record.py and
# demo/play.sh. SSHub pings every host every 30 s (`ping -c 1 -W 1 <addr>`) and
# colours the status dots and header counts from the reply. Real ICMP made the
# recordings depend on the network of the moment: one dropped reply put a red
# "unreachable" host into a README screenshot. This answers like Linux ping,
# with a fixed latency per demo address and a little jitter for the sparklines.
addr="${!#}"
case "$addr" in
    8.8.8.8) base=40 ;;
    8.8.4.4) base=39 ;;
    1.1.1.1|1.0.0.1) base=8 ;;
    9.9.9.9) base=58 ;;
    4.2.2.2) base=68 ;;
    208.67.222.222) base=65 ;;
    127.0.0.1|localhost) base=0 ;;
    *) base=45 ;;
esac
ms="$base.$(( RANDOM % 10 ))"
printf 'PING %s (%s) 56(84) bytes of data.\n' "$addr" "$addr"
printf '64 bytes from %s: icmp_seq=1 ttl=57 time=%s ms\n\n' "$addr" "$ms"
printf -- '--- %s ping statistics ---\n' "$addr"
printf '1 packets transmitted, 1 received, 0%% packet loss, time 0ms\n'
