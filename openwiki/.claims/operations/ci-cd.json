    {
      "id": "claim_ed1d182d30b2441a9a9271591d10e583",
      "statement": "openwiki-update.yml runs on workflow_dispatch and a daily 08:00 cron (`0 8 * * *`) with contents:write + pull-requests:write: it installs the openwiki npm CLI and runs `openwiki code --update --print` with a prompt that makes CHANGELOG.md the primary change ledger (audit every Unreleased and historical entry regardless of the recorded gitHead, compare against the source tree and wiki, add missing pages, update indexes and cross-links) and maintains openwiki/changelog-coverage.md as the audit notebook; it uses the OpenRouter provider with OPENROUTER_API_KEY and model z-ai/glm-5.3-flash, with LangSmith tracing enabled only when LANGSMITH_API_KEY is non-empty.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L3-L47",
          "version": "repo-lines-v1:sha256:ec81a2449380b47a4971b00cdf2cbc78e9ffb2b98dc6b952379207843625b26c:"
        }
