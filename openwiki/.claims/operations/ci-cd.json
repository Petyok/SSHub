    {
      "id": "claim_2c0570529fa94374bd5a03dc7c7e8579",
      "statement": "The release job merges all build artifacts (download-artifact with merge-multiple) and creates the GitHub release via softprops/action-gh-release@v2, attaching the sshub-*.tar.gz files with CHANGELOG.md as the release body and generate_release_notes disabled, so the changelog section `just release` rolled is the release text.",
      "evidence": [
